# Local image tag. Override it with the checked-out commit during deploy.
SHOWCASE_IMAGE_TAG=showcase

# Disposable internal PostgreSQL credentials. Use URL-safe characters.
POSTGRES_DB=pharmacy_showcase
POSTGRES_USER=pharmacy_showcase
POSTGRES_PASSWORD=pharmacy-showcase-internal

# Showcase-only application credentials.
JWT_SECRET=showcase-only-jwt-secret-2026-08-26
JWT_EXPIRES_IN=8h
