FROM node:22-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json
COPY docs-app/package.json docs-app/package.json
COPY frontend/package.json frontend/package.json
COPY packages/shared/package.json packages/shared/package.json

# Workspace lifecycle scripts are run explicitly after their sources are copied.
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM dependencies AS build

COPY backend backend
COPY packages/shared packages/shared

RUN pnpm --filter @pharmacy-pos/backend prisma:generate \
    && pnpm --filter @pharmacy-pos/backend build \
    && test -f backend/dist/prisma/seed.js \
    && test -f backend/dist/prisma/demo-seed.js \
    && test -f backend/dist/src/scripts/seed-stock-planning-prediction.js

FROM base AS runtime

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=build --chown=node:node /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/backend/package.json ./backend/package.json
COPY --from=build --chown=node:node /app/backend/node_modules ./backend/node_modules
# Includes the compiled server, operational, demo, and prediction seed entrypoints.
COPY --from=build --chown=node:node /app/backend/dist ./backend/dist
COPY --from=build --chown=node:node /app/backend/prisma ./backend/prisma
COPY --from=build --chown=node:node /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build --chown=node:node /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build --chown=node:node /app/packages/shared/dist ./packages/shared/dist

WORKDIR /app/backend

USER node

EXPOSE 4000

CMD ["node", "dist/src/server.js"]
