{
  "name": "@pharmacy-pos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @pharmacy-pos/shared build",
    "dev": "pnpm run build:shared && tsx watch src/server.ts",
    "build": "pnpm run build:shared && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "pnpm run build:shared && vitest run --config vitest.config.ts",
    "test:watch": "pnpm run build:shared && vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "pnpm run build:shared && tsx prisma/seed.ts",
    "synthetic:stock-planning": "pnpm run build:shared && tsx src/scripts/generate-stock-planning-scenarios.ts",
    "seed:stock-planning-prediction": "pnpm run build:shared && tsx src/scripts/seed-stock-planning-prediction.ts",
    "db:reset:prediction": "pnpm run build:shared && tsx src/scripts/reset-prediction-database.ts"
  },
  "dependencies": {
    "@pharmacy-pos/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "apache-arrow": "^21.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "parquet-wasm": "^0.7.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/swagger-ui-express": "^4.1.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
